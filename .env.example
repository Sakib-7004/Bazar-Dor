# Generate a unique secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Local URL in development; use your deployed HTTPS URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Leave empty for local SQLite. Use managed PostgreSQL in production.
DATABASE_URL=
# Set true only if your provider requires TLS with certificate verification.
DATABASE_SSL=false

# Add credentials from your own OAuth applications. Never commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
