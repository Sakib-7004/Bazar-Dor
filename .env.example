# Generate a unique secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Local URL in development; use your deployed HTTPS URL in production.
BETTER_AUTH_URL=http://localhost:3000

# SQLite database path. Ensure the deployed host supports persistent disk storage.
DATABASE_PATH=./database.sqlite

# Optional social sign-in credentials. OAuth buttons explain when credentials are missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
